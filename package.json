{
  "name": "antifraud-sdk-node-ts",
  "version": "0.4.1",
  "description": "Node.js adapters for neutral antifraud verification and credential-provider workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./mdoc-credential-signer": {
      "types": "./dist/mdoc-credential-signer.d.ts",
      "default": "./dist/mdoc-credential-signer.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples/deterministic-signing-key": {
      "types": "./dist/examples/deterministic-signing-key.d.ts",
      "default": "./dist/examples/deterministic-signing-key.js"
    },
    "./examples/client-assertion": {
      "types": "./dist/examples/client-assertion.d.ts",
      "default": "./dist/examples/client-assertion.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:gateway:local": "npm run build && node --test --test-concurrency=1 test/gateway-clearing-house.live.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-sdk-node-ts.git"
  },
  "devDependencies": {
    "@peculiar/x509": "3.1.0",
    "@types/node": "24.10.0",
    "reflect-metadata": "0.2.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@owf/mdoc": "0.10.0",
    "antifraud-data-utils-ts": "0.4.0",
    "antifraud-sdk-core-ts": "0.1.5",
    "jose": "4.15.9"
  }
}
